                      00001 ;===========================================================================
                      00002 ; Two-Player Reaction Time Matching Game - PIC16F877A
                      00003 ;===========================================================================
                      00004 ; PIN MAP / HARDWARE CONNECTIONS
                      00005 ;---------------------------------------------------------------------------
                      00006 ; LCD (16x2, 4-bit mode)        : RS=RD0, EN=RD1, D4-D7=RD2-RD5  (unchanged)
                      00007 ;
                      00008 ; Push buttons (each: pin->GND when pressed, +5V through 10K to pin when idle)
                      00009 ;   Master button (Judge)       : RB0
                      00010 ;   Player 1 button              : RB1
                      00011 ;   Player 2 button              : RB2
                      00012 ;
                      00013 ; Indicator LEDs (each: pin -> 220ohm resistor -> LED -> GND)
                      00014 ;   Player 1 LED                : RA0
                      00015 ;   Player 2 LED                : RA1
                      00016 ;
                      00017 ; 7-segment displays (TWO 4-digit common-ANODE modules, multiplexed)
                      00018 ;   Segments a-g                : RC0-RC6  -> 220ohm resistors -> shared
                      00019 ;                                  segment bus on BOTH displays (a-a,b-b,...)
                      00020 ;   Decimal point (DP)          : RC7      -> 220ohm resistor -> shared DP bus
                      00021 ;   Digit select address        : RE0,RE1,RE2 -> inputs A,B,C of a 74LS138
                      00022 ;                                  3-to-8 decoder (G1 tied to +5V, G2A/G2B
                      00023 ;                                  tied to GND so it is always enabled)
                      00024 ;   74LS138 outputs Y0-Y7 (active LOW) -> each through a base resistor
                      00025 ;                                  (~2.2K) to a PNP transistor (2N3906):
                      00026 ;                                    emitter  -> +5V
                      00027 ;                                    collector-> common-anode pin of ONE digit
                      00028 ;                                  Y0-Y3 -> Player 1 display digits 1-4
                      00029 ;                                  Y4-Y7 -> Player 2 display digits 1-4
                      00030 ;                                  (digit 1 = leftmost/leading zero,
                      00031 ;                                   digit 3 = "ones" digit, carries the DP)
                      00032 ;
                      00033 ; Oscillator: 4MHz crystal + 2x15pF caps (already in your schematic)
                      00034 ; MCLR: 10K pull-up to +5V (already in your schematic)
                      00035 ; ADCON1 is set to 0x07 so RA0/RA1/RE0-RE2 are configured as DIGITAL I/O
                      00036 ; (they default to analog inputs on this chip, so this step is required!)
                      00037 ;---------------------------------------------------------------------------
                      00038 ; GAME FLOW
                      00039 ;   1. Press master button  -> random target (0-60s) generated & shown on LCD
                      00040 ;   2. Both LEDs turn ON for 1s ("get set"), then OFF = GO signal
                      00041 ;   3. Both player displays count 00.0 -> up in tenths of a second
                      00042 ;   4. Each player presses their button to stop their own timer
                      00043 ;      (if a player never presses, their timer auto-stops at 60.0s)
                      00044 ;   5. Winner = whichever player's stopped time is closest to the target
                      00045 ;      (ties: nobody scores, LEDs stay off)
                      00046 ;   6. Winner's LED blinks 3x (0.25s on / 0.25s off), score is updated,
                      00047 ;      score shown on LCD line 2
                      00048 ;   7. First to 5 points -> "Wins the Game!" shown, press master to restart
                      00049 ;===========================================================================
                      00050 
                      00051     LIST P=16F877A
                      00052     #INCLUDE <P16F877A.INC>
                      00001         LIST
