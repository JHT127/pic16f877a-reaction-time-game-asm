  00000043            00090         MULTMP          ; scratch byte (Mult10 / SegTable / Div10 / Mod10)
  00000044            00091         SEGTEMP         ; final segment pattern about to be sent to PORTC
  00000045            00092         WINNER          ; 0 = tie, 1 = Player1, 2 = Player2
                      00093     ENDC
